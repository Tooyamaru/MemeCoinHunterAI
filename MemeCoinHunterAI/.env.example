# Safe development defaults. Copy to .env only when local overrides are needed.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
DATABASE_URL=
# PostgreSQL format only; never put real credentials in this file.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
LOG_LEVEL=INFO
