# Safe development defaults. Copy to .env only when local overrides are needed.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
DATABASE_URL=
# PostgreSQL format only; never put real credentials in this file.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
LOG_LEVEL=INFO

# Single-controller Operator Facade access.
# Keep the real high-entropy value only in local/hosting secret storage.
OPERATOR_BEARER_TOKEN=
OPERATOR_CASE_REGISTRY_CAPACITY=64
OPERATOR_CASE_TTL_SECONDS=1800

# Trusted bounded Solana JSON-RPC source for authenticated OAF prepare.
# The real endpoint belongs in secret/runtime configuration, not source control.
SOLANA_RPC_URL=
SOLANA_RPC_TIMEOUT_SECONDS=5
SOLANA_RPC_MAX_RESPONSE_BYTES=262144

# Optional read-only CoinGecko Demo API credential for the bounded exact-pool
# RTI-11 diagnostic used by authenticated OAF prepare.
# Store the real value only in local/hosting secret storage.
COINGECKO_DEMO_API_KEY=
